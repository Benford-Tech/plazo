# Backend API. Leave empty: the pro space calls /api on its own origin, and `npm run dev`
# forwards /api to the local backend (http://localhost:3005, or API_PROXY_TARGET).
VITE_API_URL=

# Traveller site, for the "Voir ma page" link. Leave empty in production (same domain);
# in development the site runs on http://localhost:3000.
VITE_SITE_URL=http://localhost:3000
