generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../generated/prisma-client"
  // Vercel functions run on Amazon Linux 2023.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// Whether an operator may use the platform. A suspended operator's staff cannot log in (their
// sessions are revoked) and its listings are hidden from the traveller site.
enum OperatorStatus {
  active
  suspended
}

// An operator is a parking company (a "loueur"). Everything is scoped by operator.
model Operator {
  id                     String         @id @default(cuid())
  name                   String
  slug                   String         @unique
  status                 OperatorStatus @default(active)
  suspendedAt            DateTime?
  // 09/10/2026 (« archive les parkings suspendus »): a suspended operator filed away by the platform. It leaves the
  // Loueurs and Annonces lists (filter « Archivés ») and the reminder, flight and file crons, keeps all its data;
  // « Désarchiver » brings it back as suspended, « Réactiver » as active. CHECK: archived implies suspended.
  archivedAt             DateTime?
  // Plazo's commission on online bookings, in basis points (1500 = 15 %). Null: the platform default.
  commissionBps          Int?
  // Stripe Connect (Express) account receiving the online payments, created by the onboarding.
  stripeAccountId        String?        @unique
  // 14/10/2026 (« passer Stripe en mode prod »): the account was created with live keys (true) or test keys (false). An
  // account of the other mode does not exist for the current keys: it counts as no account, and the onboarding creates
  // one in the current mode in its place.
  stripeAccountLive      Boolean        @default(false)
  // Mirrors of the account's capabilities (account.updated webhook, refreshed by the status route).
  // A parking is bookable online only while its operator's account has payouts enabled; the
  // operator's share is transferred only while it has charges enabled.
  stripeChargesEnabled   Boolean        @default(false)
  stripePayoutsEnabled   Boolean        @default(false)
  // The operator has sent its onboarding to Stripe (identity, bank details): verification pending
  // until payouts are enabled.
  stripeDetailsSubmitted Boolean        @default(false)
  // When the operator receives its share of the online payments (see src/domain/payout.ts).
  payoutSchedule         PayoutSchedule @default(AFTER_STAY)
  // Fictional operator created by the demo seed (scripts/seed-demo.ts): listed with a "Démo" badge
  // on the site and in the platform space, removed as a whole by the seed's --remove.
  isDemo                 Boolean        @default(false)
  // 21/10/2026 (« mets un environnement de démo de l'app », A + B + C): the prospects' demo operator (« Parking des
  // Cèdres (démo) »): no public listing, nothing sent outside, wiped and seeded again every night.
  prospectDemo           Boolean        @default(false)
  // M-A (06/10/2026): the local part of the operator's inbound address (<slug>@<INBOUND_EMAIL_DOMAIN>),
  // where their mailbox forwards the comparators' confirmations. Set from the operator's creation (08/10/2026);
  // null only for a row older than the migration inbound_slug_for_all, which filled them all.
  inboundSlug            String?        @unique
  // N-A (08/10/2026): end of the last hourly booking digest's window (null: never sent; see BookingDigestService).
  bookingDigestAt        DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt

  staff                 Staff[]
  parkings              Parking[]
  auditLogs             AuditLog[]
  reservations          Reservation[]
  inboundEmails         InboundEmail[]
  vehicles              ShuttleVehicle[]
  platformNotifications PlatformNotification[]
  shuttleTrips          ShuttleTrip[]
  smsSettings           OperatorSmsSettings?
  smsOutbox             SmsOutbox[]
  joinRequests          StaffJoinRequest[]
  testFeed              TestFeed?
  comparatorCommissions ComparatorCommission[]
  contractTemplates OperatorContractTemplate[]
  partnerContracts      PartnerContract[]

  @@map("operators")
}

// 15/10/2026 (« ajoute en continu des données de tests pour le chauffeur pour qu'il ait toujours des personnes à
// emmener »): the continuous fictional travellers of the platform's own test operator (« Plazo (tests) » only; see
// TestFeedService and domain/test-feed.ts). One row per operator, created switched on at the first read of the driver's
// lists; `ranAt` claims a run (at most one every 3 minutes, whatever the number of server instances).
model TestFeed {
  id          String    @id @default(cuid())
  operatorId  String    @unique
  enabled     Boolean   @default(true)
  // Claim of the last run.
  ranAt       DateTime?
  // { writes: { reservationId: updatedAtISO }, rebooks: [ISO…] }: the feed's own last write of each row (a row written
  // by anyone else since is left alone for 10 minutes) and the arrivals it rebooked in the last hour (8 at most, one more
  // when nobody is left to take).
  state       Json      @default("{}")
  lastReport  Json?
  lastError   String?
  // The member who last switched it on or off.
  changedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@map("test_feeds")
}

enum StaffRole {
  manager
  agent
  driver
  valet
}

// N-A (08/10/2026): how a staff member hears of the new bookings (see Staff.bookingNotify).
enum BookingNotify {
  immediate
  hourly
  never
}

// Operator personnel: manager, front-desk agent, shuttle driver, valet.
model Staff {
  id              String        @id @default(cuid())
  operatorId      String
  email           String        @unique // always lower-cased
  // First and last name (06/10/2026); `name` stays the display form "Prénom Nom", kept in sync by the server.
  firstName       String        @default("")
  lastName        String        @default("")
  name            String
  phone           String?
  role            StaffRole
  password        String
  isActive        Boolean       @default(true)
  lastLoginAt     DateTime?
  // Set once the person proved they own the email (verification link, or an accepted invitation).
  // Self sign-ups start unverified: they can log in, but cannot submit their listing for review.
  emailVerifiedAt DateTime?
  // Push notifications of travellers' arrivals (see ArrivalSignal): drop-offs, returns, or both.
  notifyArrivals  Boolean       @default(true)
  notifyReturns   Boolean       @default(true)
  // The post held today (R-C, 04/10/2026): the app puts that post's pages first. Only a post the role
  // covers (see domain/roles.ts allowedPosts); the role, not the post, decides the permissions.
  post            StaffRole?
  postSetAt       DateTime?
  // The shuttle vehicle taken for the day (V-A, 05/10/2026), chosen with the "Chauffeur" post and
  // preselected at the start of each trip. Counts for the local day of vehicleSetAt only.
  vehicleId       String?
  vehicleSetAt    DateTime?
  // Push notifications of the shuttles' departures and returns (N-A, 05/10/2026).
  notifyShuttles  Boolean       @default(true)
  /**
   * New bookings (N-A, 08/10/2026): a push per booking made on the site or imported (`immediate`, 06/10/2026), the
   * hourly digest of every channel (`hourly`, managers by default), or nothing (`never`).
   */
  bookingNotify   BookingNotify @default(immediate)
  // Messages from the platform (E-A, 05/10/2026): the super admin's broadcasts to the staff.
  notifyPlatform  Boolean       @default(true)
  // « Mail du matin » (21/10/2026, choice A): the day's planning, revenue and integrations by email. Null: the role's
  // default (on for managers, off for the others); the local hour of the parking it leaves at (5 to 10); the local
  // date it was last sent (once a day).
  morningEmail       Boolean?
  morningEmailHour   Int       @default(7)
  morningEmailSentOn String?
  // 13/10/2026 (sign in with Apple / Google): when the person last chose their password. Null: the stored hash is a
  // random one nobody knows (an invited manager before the invitation, a member who joined with the daily code).
  passwordSetAt   DateTime?
  // « Quitter ce parking » (the email is replaced, the names kept: business records) and « Supprimer mon compte »
  // (anonymised: names, email, phone). CHECKs: neither while active.
  leftAt          DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  operator            Operator           @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tokens              StaffToken[]
  accountTokens       AccountToken[]
  auditLogs           AuditLog[]
  createdReservations Reservation[]
  capacityStudies     CapacityStudy[]
  devices             StaffDevice[]
  shuttleTrips        ShuttleTrip[]
  shuttleVehicles     ShuttleVehicle[]   @relation("UsualDriver")
  vehicle             ShuttleVehicle?    @relation("VehicleOfTheDay", fields: [vehicleId], references: [id], onDelete: SetNull)
  identities          StaffIdentity[]
  joinRequests        StaffJoinRequest[] @relation("JoinRequestMember")
  decidedJoinRequests StaffJoinRequest[] @relation("JoinRequestDecider")
  extrasDone          ReservationExtra[] @relation("ExtraDoneBy")
  extrasRefused       ReservationExtra[] @relation("ExtraRefusedBy")

  @@index([operatorId])
  @@map("staff")
}

enum StaffTokenType {
  access
  refresh
}

// Every issued JWT is stored so it can be revoked (logout, deactivation, password change).
model StaffToken {
  id        String         @id @default(cuid())
  uid       String         @unique @default(uuid())
  staffId   String
  type      StaffTokenType
  expiresAt DateTime
  metadata  Json?          @default("{}")
  createdAt DateTime       @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_tokens")
}

enum AccountTokenType {
  invitation // set the password of an invited manager (7 days)
  email_verification // confirm the email of a self sign-up (48 hours)
}

// Single-use links sent by email. Only the SHA-256 of the token is stored: the token itself is
// only ever in the link.
model AccountToken {
  id        String           @id @default(cuid())
  staffId   String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, type])
  @@map("account_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}

// 13/10/2026: Plazo Pro sign-in with Apple (iPhone) or Google (Android).
enum IdentityProvider {
  apple
  google
}

// A person signed in with Apple or Google (the provider's stable `sub`). Linked to a member once a manager accepted
// their join request (or once a member links it from « Mon compte »); unlinked when the member leaves. One identity
// per provider and member (partial unique index in the migration). No provider token is stored.
model StaffIdentity {
  id             String           @id @default(cuid())
  provider       IdentityProvider
  subject        String
  email          String?
  emailVerified  Boolean          @default(false)
  // Apple's « Masquer mon adresse » (…@privaterelay.appleid.com).
  isPrivateEmail Boolean          @default(false)
  // From the provider (Apple: the first authorisation only), else typed on « Rejoindre un parking ».
  firstName      String           @default("")
  lastName       String           @default("")
  staffId        String?
  createdAt      DateTime         @default(now())
  lastSignInAt   DateTime?

  staff        Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  tokens       IdentityToken[]
  joinRequests StaffJoinRequest[]
  joinAttempts JoinAttempt[]

  @@unique([provider, subject])
  @@index([staffId])
  @@map("staff_identities")
}

// The short session (« onboarding ») of an identity not linked to a member yet: JWT { sub: identityId, type:
// 'onboarding', uuid } valid while its row exists, 7 days. Refused on every staff route (config/passport.ts).
model IdentityToken {
  id         String   @id @default(cuid())
  uid        String   @unique
  identityId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  identity StaffIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([identityId])
  @@map("identity_tokens")
}

enum JoinRequestStatus {
  pending
  accepted
  refused
  cancelled // by the person
  expired // 7 days without an answer
}

// A request to join an operator's team, made with its daily code; a manager accepts it (creating the member with the
// role chosen, never manager) or refuses it. One pending request per identity (partial unique index).
model StaffJoinRequest {
  id          String            @id @default(cuid())
  operatorId  String
  identityId  String
  firstName   String
  lastName    String
  email       String
  wishedRole  StaffRole
  status      JoinRequestStatus @default(pending)
  role        StaffRole?
  staffId     String?
  decidedById String?
  decidedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  operator  Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  identity  StaffIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  staff     Staff?        @relation("JoinRequestMember", fields: [staffId], references: [id], onDelete: SetNull)
  decidedBy Staff?        @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([operatorId, status, createdAt])
  @@index([identityId, createdAt])
  @@map("staff_join_requests")
}

// A daily code typed (13/10/2026): the wrong ones are counted per Apple / Google account and per address (rate-limit
// key) to stop guessing, the right ones (requests sent) too. The code typed is never stored. Purged after 7 days.
model JoinAttempt {
  id         String   @id @default(cuid())
  identityId String?
  // SHA-256 of "provider:subject" (never the raw subject): the limits are counted on it, so that deleting the identity
  // and signing in again (a new row) does not start them from zero.
  subjectKey String
  ipKey      String
  // Recorded as a wrong code before the code is read, then marked a success when it matched (a request was sent).
  success    Boolean
  createdAt  DateTime @default(now())

  identity StaffIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([identityId, createdAt])
  @@index([subjectKey, createdAt])
  @@index([ipKey, createdAt])
  @@map("join_attempts")
}

// An Apple or Google identity token already used to sign in, link or confirm (SHA-256 of the token): each one works once.
// Kept until the token's own expiry, then purged at night.
model UsedIdentityToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("used_identity_tokens")
}

model Parking {
  id                        String                                @id @default(cuid())
  operatorId                String
  name                      String
  address                   String?
  // Entrance point (WGS84). The detailed map arrives in milestone 4. Read/write through raw SQL.
  location                  Unsupported("geometry(Point, 4326)")?
  timezone                  String                                @default("Europe/Paris")
  totalCapacity             Int
  // Share of spots never offered for booking, in percent (0-50).
  safetyMarginPct           Int                                   @default(0)
  shuttleTravelMinutes      Int                                   @default(8)
  // Shuttle waves (V-A, 05/10/2026): how long before take-off a traveller must be at the terminal,
  // and how long after landing they reach the meeting point (baggage, customs).
  terminalLeadMinutes       Int                                   @default(120)
  landingDelayMinutes       Int                                   @default(30)
  // Where the shuttle picks travellers up at the airport on their return (WGS84, raw SQL like
  // location). Null: the airport of the parking's listing, else the parking itself.
  returnMeetingPoint        Unsupported("geometry(Point, 4326)")?
  // Shown to the traveller and the staff, e.g. "Terminal 1 · arrêt navettes P5".
  returnMeetingLabel        String?
  // Written directions to the meeting point for the traveller (500 characters at most).
  returnMeetingInstructions String?
  // Photo of the meeting point (URL; no upload yet, like the listing's photos).
  returnMeetingPhotoUrl     String?
  createdAt                 DateTime                              @default(now())
  updatedAt                 DateTime                              @default(now()) @updatedAt

  // Price per day beyond the longest package of the grid, in cents.
  extraDayPriceCents Int?

  // Night fees (12/10/2026, « frais de nuit », direction B): one local window, the same every day, for drop-offs and
  // returns alike ("HH:mm"; the start counts as night, the end does not; it may cross midnight), and a fixed fee for a
  // drop-off and/or a return booked in it, in cents. Plazo bookings only, frozen on the reservation. The values are kept
  // when the fees are switched off, so that switching them back on restores them (CHECKs in the migration).
  nightFeeEnabled      Boolean @default(false)
  nightStart           String?
  nightEnd             String?
  nightArrivalFeeCents Int?
  nightReturnFeeCents  Int?

  // Who sees the shuttles' position during the trips (R-B, 07/10/2026): nobody (the drivers do not
  // share it), the team only, or the team and the travellers (then "EN DIRECT" in the search results).
  shuttleTracking ShuttleTracking @default(team)

  // Services for the car (21/10/2026, « lavage intérieur, recharge hybride, recharge électrique via Plazo, même après le
  // dépôt »): a traveller orders them until this many hours before the booked return (CHECK 0 to 168).
  extrasLeadHours Int @default(24)

  operator         Operator          @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  extraOffers      ParkingExtra[]
  pricingTiers     PricingTier[]
  arrivalSignals   ArrivalSignal[]
  listing          Listing?
  shuttleTrips     ShuttleTrip[]
  plan             ParkingPlan?
  spots            ParkingSpot[]
  files            ParkingFile[]
  stops            ShuttleStop[]
  reminderSettings ReminderSettings?
  reminderEvenings ReminderEvening[]

  @@index([operatorId])
  @@map("parkings")
}

// R-B (07/10/2026): who sees the position of a parking's shuttles.
enum ShuttleTracking {
  off // the drivers do not share it
  team // the staff's live map only
  everyone // the staff and the travellers (booking, home map, "EN DIRECT")
}

// Kind of a parking spot (bloc 2). "reserved" keeps a spot out of the automatic assignment.
enum SpotKind {
  standard
  large
  covered
  pmr
  reserved
}

// Z-A (04/10/2026): which stays a spot is meant for, from its rank in the file (short: first rank
// from the aisle, long: the back of the file, medium: between).
enum StayClass {
  short
  medium
  long
}

// The operator's own parking plan (bloc 2, step "Plan"): the land, the zones and the fixed elements
// drawn on the IGN aerial photo, scoped to its parking. The spots generated from it are rows of
// ParkingSpot so the occupation and the per-spot planning can reference them. GeoJSON in WGS84.
model ParkingPlan {
  id          String    @id @default(cuid())
  parkingId   String    @unique
  // GeoJSON Polygon of the land, or null until it is drawn.
  outline     Json?
  // Cadastral parcels used for the outline: [{ id, section, numero, commune, contenance, geometry }].
  parcels     Json      @default("[]")
  // Correction of every length (areas: its square), from a dimension measured on site.
  scaleFactor Float     @default(1)
  // [{ id, name, geometry: Polygon }]
  zones       Json      @default("[]")
  // [{ id, name, kind, geometry: Polygon | LineString | Point, clearance }]
  exclusions  Json      @default("[]")
  // Layout settings (slot sizes, aisle width, max depth, setback…) and the scale calibration.
  settings    Json      @default("{}")
  // Fixed elements: [{ id, kind: entrance | exit | handover | shuttle_stop | key_box, geometry: Point }].
  landmarks   Json      @default("[]")
  // Layout the spots were generated with: selfPark | valet24 | valet5.
  layout      String?
  generatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@map("parking_plans")
}

// One spot of the plan. `code` is what the staff reads and says ("A-02-08"): zone letter, row, index.
model ParkingSpot {
  id         String     @id @default(cuid())
  parkingId  String
  zoneId     String
  code       String
  row        Int
  index      Int
  kind       SpotKind   @default(standard)
  // An inactive spot stays on the plan (greyed) but counts for nothing.
  active     Boolean    @default(true)
  // Closed ring of the spot's outline, [[lon, lat] × 5].
  geometry   Json
  // Centre of the spot, for the search and the distances.
  lon        Float
  lat        Float
  // Rank from the aisle (0: first), length of the file, and the stay class that follows (valet layouts).
  depth      Int?
  fileLength Int?
  stayClass  StayClass?
  // P-B (07/10/2026): a spot laid by hand (a row drawn on the map) survives a regeneration.
  manual     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  parking      Parking       @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([parkingId, code])
  @@index([parkingId, zoneId, row, index])
  @@map("parking_spots")
}

// S-C (07/10/2026) "Des files, pas des places": on a valet parking the unit of storage is the file (a
// lane of cars parked nose to tail, entered and left through the aisle). Cars enter in front of the
// ones already there, so a file stays sound when every car leaves before the ones behind it.
model ParkingFile {
  id         String    @id @default(cuid())
  parkingId  String
  // What the staff reads and says: "F07".
  code       String
  name       String?
  // Cars the file holds.
  capacity   Int
  // LineString from the aisle end to the back end, [[lon, lat], [lon, lat]]; null without a map.
  geometry   Json?
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)
  // Night preparation: the return day (YYYY-MM-DD) an empty file is kept for; null when free.
  plannedDay String?
  plannedAt  DateTime?
  // Planning des files (08/10/2026): the day was chosen by hand and the night preparation leaves it.
  keptByHand Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  parking      Parking       @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([parkingId, code])
  @@index([parkingId, sortOrder])
  @@map("parking_files")
}

// M-A (06/10/2026): a confirmation email forwarded to the operator's inbound address, and what became of it.
enum InboundEmailStatus {
  imported // a booking was created
  duplicate // the booking already existed (external reference)
  incomplete // recognised, but a required field is missing: staff complete it from "À vérifier"
  unrecognised // no importer knows this email: staff read it and type the booking
  dismissed // deprecated (T-A, 08/10/2026): replaced by `handled`; the migration inbound_statuses_data moved the rows
  forwarding // G-B (07/10/2026): a mail provider's forwarding confirmation (Gmail's code), shown in the setup wizard
  handled // T-A (08/10/2026): "Marquer comme traité", dealt with, with or without a booking
  archived // T-A (08/10/2026): out of the inbox, still readable in "Archivés" (90 days)
  ignored // A (14/10/2026): sent on by a too-wide mailbox rule, not from a comparator, no booking word: kept without sender, subject or text, for the wizard's alert (7 days)
}

/// C (14/10/2026, « C puis A »): how a booking email reached the Plazo address (domain/inbound-delivery.ts).
enum InboundDelivery {
  direct // the comparator wrote to the Plazo address itself
  forwarded // a rule of the parking's mailbox sent it on
  manual // someone forwarded it by hand
}

model InboundEmail {
  id            String             @id @default(cuid())
  operatorId    String
  status        InboundEmailStatus
  fromAddress   String?
  fromName      String?
  subject       String?
  // The email's text, kept 30 days for "À vérifier" (RGPD), then cleared by the nightly purge.
  textBody      String?
  provider      String?
  parsed        Json?
  missing       Json?
  // L-A (08/10/2026): what Claude made of an email no importer knew: { kind, provider, confidence, summary, model }.
  reading       Json?
  // 10/10/2026 (« pouvoir relancer l'analyse d'un mail »): what a re-analysis needs that the text lost: the email's own
  // recipients (never the Plazo address, 5 at most) and its allopark.com links (10 at most); cleared with the text.
  recipients    String[]           @default([])
  links         String[]           @default([])
  // 10/10/2026 (« Prévent captcha »): the Allopark booking page at the last analysis: { outcome: read | protected |
  // unavailable | not_found, url (the page to open by hand, failures only), at }; cleared with the text and by attach.
  pageLookup    Json?
  // 10/10/2026 (« C'est une modification »): what Plazo did of an Allopark change of a booking: { applied, reason?,
  // reservationId?, reference?, changes: [{ field, from, to }], at }; the values are personal data like the text:
  // cleared with it after 30 days, and by attach.
  change        Json?
  // The last re-analysis, asked by the staff or made by Plazo (a second one within 30 s is refused).
  analysedAt    DateTime?
  // 11/10/2026 (« Lance l'analyse automatiquement pour allopark »): the re-analyses Plazo made by itself of an email
  // whose Allopark booking page it could not read (domain/inbound-retry.ts: five at most).
  autoRetries   Int                @default(0)
  // C (14/10/2026): how the email arrived (null: received before Plazo told them apart).
  delivery      InboundDelivery?
  reservationId String?
  receivedAt    DateTime           @default(now())
  createdAt     DateTime           @default(now())

  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([operatorId, status, receivedAt])
  @@map("inbound_emails")
}

model AuditLog {
  id         String   @id @default(cuid())
  operatorId String
  staffId    String?
  action     String
  entityType String
  entityId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@map("audit_logs")
}

enum ReservationStatus {
  // Booked on the site with online payment, not paid yet: holds its place until holdExpiresAt.
  // Never shown to staff; becomes "upcoming" once paid, "cancelled" (paymentStatus expired) if not.
  pending_payment
  upcoming // booked, vehicle not dropped yet
  arrived // vehicle dropped at the parking
  shuttled_out // customer driven to the terminal
  return_requested // customer back, waiting for pick-up
  back_at_parking // customer brought back to the parking (06/10/2026), vehicle not handed back yet
  returned // vehicle handed back
  cancelled
  no_show
}

enum ReservationChannel {
  website // the operator's own booking page (milestone 3)
  phone
  counter
  aggregator // Parkos, Onepark… (name in channelDetail)
  import
  plazo // booked by a traveller on the Plazo site
}

// Online payment of a booking made on the site (null: paid at the parking, or another channel).
enum PaymentStatus {
  pending // place held, waiting for the payment
  paid
  expired // the hold ended without a payment (timeout, or the traveller went back to edit)
  refunded
}

// When an operator receives its share: the day after the drop-off, the day after the stay
// (default), every Monday for the previous week's stays, or on the 1st for the previous month's.
enum PayoutSchedule {
  AFTER_STAY
  AT_DROP_OFF
  WEEKLY
  MONTHLY
}

// The operator's share of an online payment: Plazo takes the payment on its own account, then
// transfers the share to the operator's connected account the day after the stay ends.
enum PayoutStatus {
  pending // to transfer once the stay is over
  transferred
  cancelled // the booking was cancelled (and refunded) before the transfer
  reversed // refunded after the transfer: the transfer was reversed
  failed // Stripe refused the transfer (see the logs); not retried automatically
}

// A booking. Times are stored in UTC; "nights" are counted in the parking's timezone.
model Reservation {
  id                      String              @id @default(cuid())
  reference               String              @unique // short code given to the customer
  operatorId              String
  parkingId               String
  channel                 ReservationChannel
  channelDetail           String?
  status                  ReservationStatus   @default(upcoming)
  arrivalAt               DateTime
  returnAt                DateTime
  passengers              Int
  // The traveller's first and last name (09/10/2026); `customerName` stays the display form "Prénom Nom", recomputed
  // by the server on every write (search, lists and exports keep using it).
  customerFirstName       String              @default("")
  customerLastName        String              @default("")
  customerName            String
  customerPhone           String
  customerEmail           String?
  plate                   String // display form, e.g. AB-123-CD
  plateKey                String // letters and digits only, for search
  returnFlight            String? // e.g. TO 3627
  // Outbound flight (V-A "Vagues de navettes", 05/10/2026): sets when the drop-off shuttle must leave.
  departureFlight         String? // e.g. AF 7641
  notes                   String?
  // Booking number on the channel it came from (e.g. AL-884880719 on Allopark), to avoid importing it twice.
  externalReference       String?
  // Price paid, in euro cents, when known: the comparator's amount (imports), the staff's, or on Plazo the grid price plus
  // the night fees (the total « tout compris » the traveller paid).
  priceCents              Int?
  // 10/10/2026: the amount the comparator last gave (import, applied change). A comparator's change touches the price
  // only when its amount differs from this one, so a price the staff corrected stays theirs.
  importedPriceCents      Int?
  // What the comparator takes on this one booking when it differs from its usual rate (19/10/2026, « paramétrer le
  // taux de commission de chaque comparateur »): a rate in basis points, or an amount in cents; never both, and only
  // for a comparator's booking (CHECKs). Null: the comparator's rate of the day the booking was made.
  commissionOverrideBp    Int?
  commissionOverrideCents Int?
  // 12/10/2026: night fees charged at booking on Plazo (drop-off, return), frozen when the place is held and included in
  // priceCents; null when none (and always for the other channels). A late flight or a staff edit never recomputes them.
  nightArrivalFeeCents    Int?
  nightReturnFeeCents     Int?
  // Saved although at least one night was already full (forced by staff, audited).
  overbooked              Boolean             @default(false)
  // Cancellation terms accepted by the traveller when booking on the site (channel plazo): later
  // changes to the listing's policy do not apply to it. Null for the other channels.
  cancellationPolicy      CancellationPolicy?
  // Key sent by the site with a booking form: a retried submission returns the booking already
  // made instead of holding a second place (channel plazo only).
  idempotencyKey          String?             @unique
  // Part of the traveller's manage link (channel plazo): staff increase it to revoke a leaked link.
  manageTokenVersion      Int                 @default(0)
  // Bloc 2, Occupation: the spot the vehicle is (or will be) parked on, and where its keys hang.
  spotId                  String?
  // S-C (07/10/2026): the file the car stands in and its entry rank (1 = deepest, at the back).
  fileId                  String?
  fileRank                Int?
  keyHook                 String?
  /// 26/10/2026: keys handed over without a hook noted yet (« Clés laissées » in one click).
  keysLeftAt              DateTime?
  // Where the shuttle serves this traveller (D-A, 05/10/2026): a stop of the parking (train station…);
  // null: the airport (the return meeting point).
  stopId                  String?
  // Online payment (Stripe Checkout on Plazo's account; "separate charges and transfers").
  paymentStatus           PaymentStatus?
  // End of the place's hold while the payment is pending (lazy expiry: past it, the place is free).
  holdExpiresAt           DateTime?
  stripeCheckoutSessionId String?             @unique
  stripePaymentIntentId   String?
  stripeChargeId          String?
  stripeRefundId          String?
  // 14/10/2026: the payment page or sheet was created with live keys (true) or test keys (false or null: every payment
  // before this date, live keys being refused in production). A test payment moves no money once the keys are live:
  // nothing to refund at Stripe, no payout.
  stripeLive              Boolean?
  // Amounts in cents, computed by the backend when the place is held: what the traveller pays,
  // Plazo's commission, and the operator's share (charged = commission + share).
  chargedCents            Int?
  commissionCents         Int?
  operatorShareCents      Int?
  // 21/10/2026: the services for the car asked with the booking, paid in the same payment on top of chargedCents (their
  // commission and share are on reservation_extras). Null: none.
  extrasChargedCents      Int?
  // Transfer of the operator's share (null until the booking is paid).
  payoutStatus            PayoutStatus?
  stripeTransferId        String?
  transferredAt           DateTime?
  paidAt                  DateTime?
  refundedAt              DateTime?
  // E (06/10/2026): what the traveller tells the parking — a message at booking, the vehicle
  // (so the valet spots it), and a notice on the return day ("mon vol a du retard", "bagage perdu").
  customerNote            String?
  vehicleModel            String?
  vehicleColour           String?
  // Child car seats for the shuttle (24/10/2026, direction B « par âge »): how many of each kind the
  // parking installs, both ways. Children count in `passengers`. CHECK 0..4 each in the migration.
  childSeatInfant         Int               @default(0)
  childSeatToddler        Int               @default(0)
  childSeatBooster        Int               @default(0)
  returnNoticeKind        ReturnNoticeKind?
  returnNoticeText        String?
  returnNoticeAt          DateTime?
  // Set when the confirmation email/SMS went out: they are sent exactly once.
  confirmationSentAt      DateTime?
  createdById             String?
  arrivedAt               DateTime?
  // « Embarquer en un geste » (14/10/2026): the drop-off trip at whose boarding the traveller, not checked in yet, was
  // checked in (« Pointé à l'embarquement »); null otherwise, and again when the booking goes back to "upcoming".
  boardingTripId          String?
  returnedAt              DateTime?
  cancelledAt             DateTime?
  // Return flight tracking (see src/domain/flight.ts): refreshed by the cron and lazily when read
  // (5-minute cache on flightCheckedAt), or set by the traveller ("J'ai atterri").
  flightStatus            FlightStatus?
  flightScheduledAt       DateTime? // scheduled landing
  flightEstimatedAt       DateTime? // revised / predicted landing
  flightLandedAt          DateTime? // actual landing (tracking) or when the traveller said so
  flightLandedSource      FlightLandedSource?
  flightTerminal          String?
  flightGate              String?
  flightCheckedAt         DateTime? // last lookup at the provider (cache)
  // Outbound flight tracking (take-off), same provider and cache rules; nothing is sent on it.
  departureStatus         FlightStatus?
  departureScheduledAt    DateTime? // scheduled take-off
  departureEstimatedAt    DateTime? // revised take-off
  departureTerminal       String?
  departureCheckedAt      DateTime?
  // Where the car is parked (06/10/2026): recorded by whoever parks it, the traveller from the app
  // or a staff member (valet) from Plazo Pro, whose position prevails. Erased with the traveller
  // devices two days after the return.
  carLat                  Float?
  carLng                  Float?
  carAccuracyM            Int?
  carLocatedAt            DateTime?
  carLocatedBy            CarLocatedBy?
  carNote                 String?
  // Sent once per booking when the flight lands: the push to the staff, the SMS to the traveller.
  landingNotifiedAt       DateTime?
  landingSmsAt            DateTime?
  // The traveller's message thread (B, 06/10/2026), each sent once: the day-before reminder, "votre
  // voiture est garée", the closing message after the handover.
  reminderSentAt          DateTime?
  // The day-before SMS (S-A + S-B, 06/10/2026): left out by a staff member ("Ne pas envoyer").
  reminderExcludedAt      DateTime?
  reminderExcludedById    String?
  parkedNotifiedAt        DateTime?
  closingSentAt           DateTime?
  // Retention (privacy policy, 06/10/2026): 12 months after the return, the nightly cron removes who
  // the traveller is (name, contact details, plate, flights, notes); see src/domain/retention.ts.
  anonymizedAt            DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @default(now()) @updatedAt

  operator       Operator               @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  parking        Parking                @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  createdBy      Staff?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  spot           ParkingSpot?           @relation(fields: [spotId], references: [id], onDelete: SetNull)
  file           ParkingFile?           @relation(fields: [fileId], references: [id], onDelete: SetNull)
  stop           ShuttleStop?           @relation(fields: [stopId], references: [id], onDelete: SetNull)
  boardingTrip   ShuttleTrip?           @relation("BoardingCheckIn", fields: [boardingTripId], references: [id], onDelete: SetNull)
  devices        TravellerDevice[]
  arrivalSignals ArrivalSignal[]
  inboundEmails  InboundEmail[]
  shuttleTrips   ShuttleTripPassenger[]
  smsOutbox      SmsOutbox[]
  contract       ReservationContract?
  inspections    VehicleInspection[]
  signatureCodes SignatureCode[]
  extras         ReservationExtra[]

  @@unique([operatorId, externalReference])
  @@index([spotId])
  @@index([fileId])
  @@index([boardingTripId])
  @@index([parkingId, arrivalAt])
  @@index([parkingId, returnAt])
  @@index([operatorId, plateKey])
  @@index([status, holdExpiresAt])
  @@index([payoutStatus, arrivalAt])
  @@map("reservations")
}

// Airports served by the platform (Lyon Saint-Exupéry first).
model Airport {
  id        String   @id @default(cuid())
  code      String   @unique // IATA, e.g. LYS
  name      String
  city      String
  slug      String   @unique // URL of the airport page, e.g. lyon-saint-exupery
  timezone  String   @default("Europe/Paris")
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  listings Listing[]

  @@map("airports")
}

// "Package up to N days": a stay of D days costs the smallest package with days >= D.
model PricingTier {
  id         String @id @default(cuid())
  parkingId  String
  days       Int
  priceCents Int

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@unique([parkingId, days])
  @@map("pricing_tiers")
}

enum CancellationPolicy {
  free_until_arrival
  free_24h
  free_48h
  non_refundable
}

// Review of a listing by the platform: draft -> pending_review (sent by the operator) -> published
// (validated) or rejected (with a message). Only published listings appear on the site.
enum ListingStatus {
  draft
  pending_review
  published
  rejected
}

// The parking's public page on Plazo.
model Listing {
  id                 String             @id @default(cuid())
  parkingId          String             @unique
  airportId          String
  slug               String // unique per airport, e.g. parking-demo
  status             ListingStatus      @default(draft)
  // Message of the platform with its last decision (required on a refusal), shown to the operator.
  reviewMessage      String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  title              String
  description        String?
  services           String[] // shuttle, valet, covered, ev_charging, open_24h, fenced, cctv
  shuttleMinutes     Int?
  // Average wait for the shuttle, in minutes, as the operator declares it (14/10/2026, « Temps d'attente moyen »);
  // null: not declared, the tag is not shown.
  shuttleWaitMinutes Int?
  distanceKm         Float?
  openingHours       String? // free text, e.g. "24h/24" or "5h – 0h"
  // Phone travellers can call (shown on the page and in their booking), e.g. "04 72 00 00 00".
  contactPhone       String?
  cancellationPolicy CancellationPolicy @default(free_24h)
  photos             String[] // URLs
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  airport Airport @relation(fields: [airportId], references: [id])

  @@unique([airportId, slug])
  @@index([status])
  @@map("listings")
}

// Internal tool of the platform owner (capacity estimator): a study of a piece of land.
// Platform-level data: NOT scoped to an operator (only platform admins can read or write it).
// Geometries are GeoJSON in WGS84 (EPSG:4326); lengths and areas are computed in Lambert-93.
model CapacityStudy {
  id          String   @id @default(cuid())
  name        String
  createdById String?
  // GeoJSON Polygon of the land, or null until it is drawn.
  outline     Json?
  // Cadastral parcels used for the outline: [{ id, section, numero, commune, contenance, geometry }].
  parcels     Json     @default("[]")
  // Correction of every length (areas: its square), from a dimension measured on site.
  scaleFactor Float    @default(1)
  // [{ id, name, geometry: Polygon }]
  zones       Json     @default("[]")
  // [{ id, name, kind, geometry: Polygon | LineString | Point, clearance }]
  exclusions  Json     @default("[]")
  // Layout settings (slot sizes, aisle width, max depth, setback…) and the scale calibration.
  settings    Json     @default("{}")
  // Summary of the last estimate (counts per layout), recomputed by the pro space.
  results     Json     @default("{}")
  // Cars counted by hand on the aerial photo: [[lon, lat], …].
  carMarkers  Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  createdBy Staff? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
  @@map("capacity_studies")
}

// Which moment of the stay a traveller signals: the drop-off at the parking, or the pick-up at the
// airport's meeting point on the way back.
enum ArrivalKind {
  outbound
  return
}

/**
 * E (06/10/2026): what a traveller can signal on the return day.
 */
enum ReturnNoticeKind {
  flight_delayed
  luggage
  other
}

enum ArrivalState {
  sharing // live position shared with the parking
  announced // "J'arrive dans 10 / 20 / 30 min", no position
  at_meeting_point // the traveller is there (within 150 m, or said so)
  ended // stopped, expired after 2 h, or closed: no position, not shown to staff
}

enum ArrivalEndReason {
  stopped // by the traveller
  expired // 2 h after the start
  closed // the booking moved on (vehicle dropped off, handed back, cancelled)
}

// A traveller telling the parking they are coming (see SPEC.md, "Prévenir de son arrivée").
// One row per booking and moment, reused when the traveller starts again: never a history. Only
// the LATEST position is kept, while sharing; it is erased on stop, on arrival and after 2 h
// (lazily when read, and by the cron). The audit log records the events, never coordinates.
model ArrivalSignal {
  id                 String            @id @default(cuid())
  reservationId      String
  operatorId         String
  parkingId          String
  kind               ArrivalKind
  state              ArrivalState
  endReason          ArrivalEndReason?
  // Latest position only (WGS84), null outside a live sharing.
  lat                Float?
  lng                Float?
  accuracyM          Float?
  positionRecordedAt DateTime? // on the phone
  positionReceivedAt DateTime? // by the API (rate limit)
  // Estimate from the latest position, or from the traveller's announce.
  distanceM          Int?
  etaMinutes         Int?
  etaAt              DateTime?
  announcedMinutes   Int?
  // E (06/10/2026): a word for the parking, sent with the signal ("2 enfants, poussette").
  note               String?
  startedAt          DateTime
  expiresAt          DateTime
  atMeetingPointAt   DateTime?
  endedAt            DateTime?
  // Push notifications already sent for this session (each one at most once).
  notifiedStartAt    DateTime?
  notifiedSoonAt     DateTime?
  notifiedArrivedAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  parking     Parking     @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@unique([reservationId, kind])
  @@index([operatorId, state])
  @@index([state, expiresAt])
  @@map("arrival_signals")
}

// A staff member's phone registered for push notifications (OneSignal subscription id).
model StaffDevice {
  id             String   @id @default(cuid())
  staffId        String
  subscriptionId String   @unique
  platform       String? // ios, android, web
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_devices")
}

// State of a tracked return flight, as the provider reports it (AeroDataBox or AirLabs).
enum FlightStatus {
  scheduled // expected, not departed yet
  delayed
  departed // en route, approaching
  landed
  cancelled
  diverted
  unknown // the provider does not know this flight (or on that day)
}

/// Who recorded the car's position: the traveller (self-parking) or the staff (valet).
enum CarLocatedBy {
  traveller
  staff
}

enum FlightLandedSource {
  tracking // the flight tracking API
  traveller // "J'ai atterri" in the app
}

// A shuttle of the operator (the driver picks one when starting a trip).
model ShuttleVehicle {
  id         String   @id @default(cuid())
  operatorId String
  model      String // e.g. "Mercedes Vito"
  colour     String? // e.g. "blanche"
  plate      String? // display form, e.g. GH-456-JK
  seats      Int? // passenger seats (the driver's excluded); null: unknown
  inService  Boolean  @default(true) // false: in the garage, not offered at the start of a trip
  driverId   String? // the usual driver, preselected in their app
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  operator Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  driver   Staff?        @relation("UsualDriver", fields: [driverId], references: [id], onDelete: SetNull)
  trips    ShuttleTrip[]
  // Who took it today (V-A).
  holders  Staff[]       @relation("VehicleOfTheDay")

  @@index([operatorId])
  @@map("shuttle_vehicles")
}

enum ShuttleTripStatus {
  running
  ended
}

/// Where the shuttle goes: to the airport to pick returning travellers up, or to the terminal
/// to drop off the travellers who just left their vehicle at the parking.
enum ShuttleTripDirection {
  pickup
  dropoff
}

enum ShuttleTripEndReason {
  completed // "Clients récupérés · retour parking" / "Clients déposés au terminal"
  expired // 90 minutes after the start
}

// A driver's trip: to the airport to pick up returning travellers (`pickup`), or to the terminal with
// travellers who just left their vehicle (`dropoff`, T-A 04/10/2026); see SPEC.md, block 3. The
// driver's LATEST position only is kept while the trip runs, visible to its passengers only; it is
// erased when the trip ends (by the driver, or 90 minutes after the start). The audit log holds
// the events, never coordinates.
model ShuttleTrip {
  id                 String                @id @default(cuid())
  operatorId         String
  parkingId          String
  driverId           String
  vehicleId          String?
  // Snapshot shown to the travellers (the vehicle may be edited or deleted later).
  vehicleModel       String?
  vehicleColour      String?
  vehiclePlate       String?
  direction          ShuttleTripDirection  @default(pickup)
  // The stop served (D-A): null = the airport (return meeting point). Snapshot for the history.
  stopId             String?
  stopKind           ShuttleStopKind?
  stopName           String?
  // "Votre navette est là" sent to the passengers once (N-A).
  arrivedNotifiedAt  DateTime?
  status             ShuttleTripStatus
  endReason          ShuttleTripEndReason?
  startedAt          DateTime
  expiresAt          DateTime
  endedAt            DateTime?
  // Latest position only (WGS84), null outside a running trip.
  lat                Float?
  lng                Float?
  accuracyM          Float?
  positionRecordedAt DateTime? // on the phone
  positionReceivedAt DateTime? // by the API (rate limit)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @default(now()) @updatedAt

  operator   Operator               @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  parking    Parking                @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  driver     Staff                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle    ShuttleVehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stop       ShuttleStop?           @relation(fields: [stopId], references: [id], onDelete: SetNull)
  passengers ShuttleTripPassenger[]
  // The bookings checked in when they boarded this drop-off (« Embarquer en un geste »).
  checkIns   Reservation[]          @relation("BoardingCheckIn")

  @@index([operatorId, status])
  @@index([driverId, status])
  @@index([status, expiresAt])
  @@map("shuttle_trips")
}

model ShuttleTripPassenger {
  tripId        String
  reservationId String
  createdAt     DateTime @default(now())

  trip        ShuttleTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@id([tripId, reservationId])
  @@index([reservationId])
  @@map("shuttle_trip_passengers")
}

/// Kind of a place the shuttle serves besides the airport (D-A, 05/10/2026).
enum ShuttleStopKind {
  airport
  station
  other
}

// A place the shuttle serves (D-A, 05/10/2026): a train station, a hotel, a second terminal… The
// airport itself is implicit (the parking's return meeting point, else the listing's airport) and
// is not a row here. Coordinates as plain WGS84 floats, like the trips' positions.
model ShuttleStop {
  id           String          @id @default(cuid())
  parkingId    String
  kind         ShuttleStopKind @default(other)
  name         String // e.g. "Gare Saint-Exupéry TGV"
  lat          Float
  lng          Float
  instructions String? // for the traveller (500 characters at most)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  parking      Parking       @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  trips        ShuttleTrip[]
  reservations Reservation[]

  @@index([parkingId])
  @@map("shuttle_stops")
}

// A traveller's phone registered for the pushes about their shuttle (N-A, 05/10/2026), through the
// booking's manage token. Removed with the booking, and by the nightly cron two days after the return.
model TravellerDevice {
  id             String   @id @default(cuid())
  reservationId  String
  subscriptionId String   @unique
  platform       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("traveller_devices")
}

/// Who a platform broadcast goes to (E-A, 05/10/2026).
enum PlatformAudience {
  staff // every operator's active staff (notifyPlatform)
  travellers // every traveller phone registered on a current booking
  operator // one operator's staff
}

// A push sent by the super admin to the staff or the travellers (E-A, 05/10/2026): the history of
// the "Notifications" tab of the platform space. The text is kept (the audit log has it too).
model PlatformNotification {
  id         String           @id @default(cuid())
  audience   PlatformAudience
  operatorId String? // audience "operator"
  title      String
  body       String
  url        String? // opened when the notification is tapped
  recipients Int // phones the push went to
  sentById   String?
  sentByName String
  createdAt  DateTime         @default(now())

  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("platform_notifications")
}

// How an operator's SMS to travellers go out (see src/services/sms.service.ts).
enum SmsMode {
  gateway // the operator's own Android phone, through "SMS Gateway for Android" (free)
  brevo // the platform sends through Brevo (charged per SMS)
  none // emails only
}

// One row per operator: the channel chosen and, for the gateway, the app's credentials. The
// gateway password is encrypted at rest (AES-256-GCM, SMS_GATEWAY_ENCRYPTION_KEY) and never
// returned by the API. lastError holds a machine code only (no number, no message text).
model OperatorSmsSettings {
  id                       String    @id @default(cuid())
  operatorId               String    @unique
  mode                     SmsMode   @default(none)
  // Base URL of the gateway API; null = the public cloud server (https://api.sms-gate.app/3rdparty/v1).
  gatewayBaseUrl           String?
  gatewayLogin             String?
  gatewayPasswordEncrypted String?
  // Number of the phone sending the SMS (E.164), shown to the operator as the sender.
  senderPhone              String?
  linkedAt                 DateTime?
  lastSentAt               DateTime?
  lastError                String?
  lastErrorAt              DateTime?
  // Counters of the month in monthKey ("2026-10"), reset when the month changes.
  monthKey                 String?
  monthSent                Int       @default(0)
  monthFailed              Int       @default(0)
  // Last time the queued SMS were checked at the gateway (lazy refresh, throttled).
  queueCheckedAt           DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  @@map("operator_sms_settings")
}

enum SmsOutboxStatus {
  queued // waiting at the gateway or for a retry
  sent // the phone sent it
  delivered // the network confirmed the delivery
  failed // the last attempt failed; retried while the row is less than 2 h old
  abandoned // still not sent after 2 h
}

// SMS handed to a provider, without their text (only its SHA-256). The recipient's number is kept
// for the retries and purged with the row after 30 days (nightly cron).
model SmsOutbox {
  id                String          @id @default(cuid())
  operatorId        String
  reservationId     String?
  // What the SMS was: booking_confirmed, flight_landed, test...
  kind              String
  to                String
  bodyHash          String
  provider          String
  providerMessageId String?
  status            SmsOutboxStatus @default(queued)
  attempts          Int             @default(0)
  // Machine code of the last failure (no personal data).
  lastError         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @default(now()) @updatedAt

  operator    Operator     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([operatorId, status])
  @@index([createdAt])
  @@map("sms_outbox")
}

// The day-before SMS of a parking (« SMS de la veille », S-A + S-B, 06/10/2026). No row: on, 18:00,
// Plazo's text. The reminder (SMS, email, push) leaves at that local time the evening before the
// drop-off; see src/domain/day-before-sms.ts.
model ReminderSettings {
  id          String   @id @default(cuid())
  parkingId   String   @unique
  enabled     Boolean  @default(true)
  // Local "HH:MM", every half hour from 16:00 to 21:30 (CHECK in the migration).
  sendTime    String   @default("18:00")
  // The parking's own text with its variables ({prénom}, {date}…); null: Plazo's text.
  template    String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@map("reminder_settings")
}

// One evening that differs from the parking's usual rule: another time, or paused.
model ReminderEvening {
  id          String   @id @default(cuid())
  parkingId   String
  // Local date of the evening ("YYYY-MM-DD"); its reminders are for the next day's drop-offs.
  date        String
  sendTime    String?
  paused      Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@unique([parkingId, date])
  @@map("reminder_evenings")
}

// ---- Prospection (18/10/2026, « ajoute un outil d'envoi d'email de prospection », choix « A avec les relances de B ») ----
// Airport parkings the platform owner emails to bring them to Plazo (Plateforme › Prospection). Professionals only,
// entered by hand or from a CSV the admin provides; deleted 3 years after the last contact (nightly purge).

/// Where a prospect stands. replied, interested, not_interested and unsubscribed stop the follow-ups for good.
enum ProspectStatus {
  to_contact
  contacted
  replied
  interested
  not_interested
  unsubscribed
}

enum ProspectSource {
  manual
  csv
}

enum ProspectMessageStatus {
  sent
  failed
}

model Prospect {
  id               String         @id @default(cuid())
  // Lower-cased.
  email            String         @unique
  companyName      String
  contactFirstName String?
  contactLastName  String?
  town             String?
  // IATA code, e.g. LYS.
  airportCode      String?
  // Region chosen by hand (key of domain/prospect-regions.ts); null: the airport's region (19/10/2026).
  region           String?
  phone            String?
  notes            String?
  source           ProspectSource @default(manual)
  status           ProspectStatus @default(to_contact)
  // Last step of the sequence sent (0: none yet).
  step             Int            @default(0)
  // When the next step is due (null: not enrolled, finished or stopped).
  nextSendAt       DateTime?
  // J0 of the sequence: when the first message actually left.
  firstContactedAt DateTime?
  lastContactedAt  DateTime?
  // The follow-ups were stopped (by hand, or by a reply / interest / unsubscription).
  stoppedAt        DateTime?
  // Claimed by a sending pass (never two passes on the same prospect).
  sendingAt        DateTime?
  // Brevo refusals in a row on the current step (3: stopped).
  failedAttempts   Int            @default(0)
  // The platform admin who enrolled the prospect: the replies go to them unless PROSPECTING_REPLY_TO is set.
  enrolledById     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  demoLink         DemoLink?

  messages ProspectMessage[]

  @@index([status])
  @@index([nextSendAt])
  @@map("prospects")
}

// One email sent to a prospect (its subject only; the body is the step's template at the time).
model ProspectMessage {
  id                String                @id @default(cuid())
  prospectId        String
  step              Int
  subject           String
  sentAt            DateTime              @default(now())
  providerMessageId String?
  status            ProspectMessageStatus
  // Machine code of the failure (no personal data).
  error             String?

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
  @@index([sentAt])
  @@map("prospect_messages")
}

// The sequence (3 steps: subject, body, delay, on/off) and the daily cap. One row (id "default"); none: Plazo's texts.
model ProspectingSettings {
  id          String   @id @default("default")
  steps       Json
  dailyCap    Int      @default(50)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("prospecting_settings")
}

// An address that asked never to be contacted again: sha256 of the lower-cased email, kept when the prospect is deleted.
model ProspectSuppression {
  emailHash String   @id
  createdAt DateTime @default(now())

  @@map("prospect_suppressions")
}

// ---- Contrat signé et état des lieux (19/10/2026, « A, tout dans les applis ») --------------------------------------------

/// How a contract or a condition report was signed: a code sent by SMS to the traveller's phone (in the traveller app or
/// typed on the staff's phone), or a handwritten signature drawn on the staff's phone.
enum SignatureMethod {
  sms_code
  handwritten
  // The traveller answered in the app, signed in by their booking's link (a condition report only).
  booking_link
}

/// Where the signature was made.
enum SignatureDevice {
  traveller_app
  staff_device
}

/// The parking contract of a booking, signed once (simple electronic signature, eIDAS art. 25): the exact text signed, its
/// SHA-256 and the proof (method, when, device, the masked phone). The text is a snapshot: a later change of the booking
/// or of Plazo's template never changes what was signed.
model ReservationContract {
  id            String          @id @default(cuid())
  reservationId String          @unique
  // Version of Plazo's contract template, e.g. "2026-10-19", or "pdf-3" when the parking's own PDF (v3) was signed.
  version       String
  // The parking's own contract (26/10/2026, choice A): the PDF the traveller signed, when the parking hosts one.
  templateId    String?
  // The whole text signed (title and clauses, one per line) and its SHA-256 (hex).
  text          String
  textSha256    String
  signerName    String
  method        SignatureMethod
  device        SignatureDevice
  // "06 •• •• •• 42": the phone the code went to (sms_code), never the whole number.
  phoneMasked   String?
  // Handwritten: the strokes as drawn ([[[x, y], …], …], 0-1 of the pad), and their SHA-256.
  strokes       Json?
  // Staff member whose phone was used (staff_device).
  witnessedById String?
  signedAt      DateTime        @default(now())
  // Proof: SHA-256 of "text + signer + method + signedAt", shown in the emailed copy.
  proofSha256   String
  emailedAt     DateTime?
  // The PDF signed (the parking's contract, or Plazo's text laid out, plus the « Réservation et signature » page) and
  // the proof (that page alone), in the private store; null when the store was unavailable at the signature.
  signedBlobKey String?
  signedSha256  String?
  proofBlobKey  String?

  reservation Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  template    OperatorContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("reservation_contracts")
}

/// The parking's own contract (26/10/2026, « chaque parking peut héberger le contrat de stationnement à ses clients »,
/// choice A « Mon PDF »): a PDF per operator, versioned; the one without retiredAt is in force (partial unique index).
/// Without one, the travellers sign Plazo's template (domain/contract.ts).
model OperatorContractTemplate {
  id           String    @id @default(cuid())
  operatorId   String
  operator     Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… per operator.
  version      Int
  title        String
  fileName     String
  sizeBytes    Int
  pageCount    Int
  /// SHA-256 (hex) of the PDF uploaded.
  sha256       String
  blobKey      String
  uploadedById String?
  uploadedAt   DateTime  @default(now())
  retiredAt    DateTime?
  retiredById  String?

  contracts ReservationContract[]

  @@unique([operatorId, version])
  @@index([operatorId, retiredAt])
  @@map("operator_contract_templates")
}

/// A one-time code sent by SMS to sign (purpose "contract"). Only its HMAC is kept.
model SignatureCode {
  id            String    @id @default(cuid())
  reservationId String
  purpose       String
  codeHash      String
  phoneMasked   String
  expiresAt     DateTime
  attempts      Int       @default(0)
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("signature_codes")
}

enum InspectionKind {
  dropoff
  return
}

/// Who took a condition report (20/10/2026, « les deux peuvent faire l'état des lieux »): the staff in Plazo Pro, or the
/// traveller in the app (their own photos before handing the keys over, and at the return; no answer, no mileage).
enum InspectionAuthor {
  staff
  traveller
}

/// The traveller's answer to a condition report.
enum InspectionDecision {
  pending
  accepted
  // Not answered before the drop-off shuttle left (drop-off) : the report stands as made.
  accepted_by_default
  // The traveller disagrees (an omission at the drop-off, a new damage at the return): a dispute for the operator.
  reserved
}

/// The condition report of a vehicle at the drop-off or at the return, made by the staff in Plazo Pro: six guided photos,
/// the damages marked on the car's outline, mileage and fuel; then the traveller's answer (signed on the staff's phone,
/// or in the traveller app). Photos are erased 90 days after the return (365 with a reservation), the row with the booking's
/// anonymisation.
model VehicleInspection {
  id             String             @id @default(cuid())
  reservationId  String
  kind           InspectionKind
  author         InspectionAuthor   @default(staff)
  // [{ "n": 1, "x": 0.8, "y": 0.2, "label": "Rayure, aile avant droite", "photoId": "…" }]: x, y from 0 to 1 on the outline.
  damages        Json               @default("[]")
  mileageKm      Int?
  // 0 to 4 quarters of a tank (4: full).
  fuelQuarters   Int?
  notes          String?
  performedById  String?
  startedAt      DateTime           @default(now())
  // Null while the staff is still taking it (a draft).
  completedAt    DateTime?
  decision       InspectionDecision @default(pending)
  decidedAt      DateTime?
  decisionMethod SignatureMethod?
  decisionDevice SignatureDevice?
  // Handwritten signature on the staff's phone.
  strokes        Json?
  // The traveller's words with a reservation.
  reserveText    String?
  // SHA-256 of the report as answered (photos' hashes, damages, mileage, fuel, decision, when).
  proofSha256    String?
  photosErasedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  reservation Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  photos      InspectionPhoto[]

  @@unique([reservationId, kind, author])
  @@map("vehicle_inspections")
}

/// One photo of a condition report, kept in private Vercel Blob storage (never a public link: the API streams it).
model InspectionPhoto {
  id           String   @id @default(cuid())
  inspectionId String
  // front, right, back, left, dashboard, interior, or damage (a close-up, any number).
  slot         String
  storageKey   String
  contentType  String
  bytes        Int
  sha256       String
  takenAt      DateTime @default(now())

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("inspection_photos")
}

/// What a comparator takes from the operator's bookings (19/10/2026, « paramétrer le taux de commission de chaque
/// comparateur »): a rate (basis points, 1800 = 18 %) and a fixed amount per booking, from a local day on. A booking
/// takes the row of its comparator in force the day it was made (`effectiveFrom` ≤ that day, the latest), so a change
/// never moves the bookings made before it.
model ComparatorCommission {
  id            String   @id @default(cuid())
  operatorId    String
  operator      Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  /// The comparator's name lowercased, spaces collapsed (« allopark »), as the bookings' `channelDetail`.
  comparatorKey String
  /// The name as shown (« Allopark »).
  label         String
  rateBp        Int
  fixedCents    Int      @default(0)
  /// Local date « YYYY-MM-DD » of the parking.
  effectiveFrom String
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([operatorId, comparatorKey, effectiveFrom])
  @@map("comparator_commissions")
}

/// The Plazo ↔ operator contract (20/10/2026, « Pouvoir stocker le contrat à faire signer », choice 2a): the platform
/// uploads a PDF per operator, a manager signs it in the pro space (typed full name + « Lu et approuvé »). The PDFs live
/// in the private Blob store (keys below), never in the database.
enum PartnerContractStatus {
  pending
  signed
  superseded
}

model PartnerContract {
  id              String                @id @default(cuid())
  operatorId      String
  operator        Operator              @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… per operator.
  version         Int
  title           String
  fileName        String
  sizeBytes       Int
  /// SHA-256 (hex) of the PDF uploaded.
  sha256          String
  blobKey         String
  uploadedById    String?
  uploadedAt      DateTime              @default(now())
  status          PartnerContractStatus @default(pending)
  /// Last email to the managers (upload, « Renvoyer l'e-mail »).
  notifiedAt      DateTime?
  signedAt        DateTime?
  signedById      String?
  /// The full name typed as signature.
  signerName      String?
  signerEmail     String?
  signerIp        String?
  signerUserAgent String?
  /// The PDF signed: the original plus a « Signature » page; and the proof page alone.
  signedBlobKey   String?
  signedSha256    String?
  proofBlobKey    String?

  @@unique([operatorId, version])
  @@index([operatorId, status])
  @@map("partner_contracts")
}

// ---- Services for the car (21/10/2026) ------------------------------------------------------------------------------

enum ExtraKind {
  interior_wash // lavage intérieur et shampouineuse
  hybrid_charge // recharge d'une hybride rechargeable
  ev_charge // recharge d'une voiture électrique
}

enum ExtraStatus {
  pending_payment // ordered, not paid yet (the app's payment sheet, or the booking's own payment)
  ordered // paid, to do before the return
  done // done by the team (« Fait »)
  refused // the team could not do it (« Pas possible »): refunded
  refunded // refunded otherwise (not done by the handover, booking cancelled)
  expired // never paid
}

// A service a parking offers on Plazo, and its price. No row: not offered (the defaults are shown to the manager).
model ParkingExtra {
  id         String    @id @default(cuid())
  parkingId  String
  kind       ExtraKind
  enabled    Boolean   @default(false)
  priceCents Int // CHECK 100 to 100 000
  updatedAt  DateTime  @default(now()) @updatedAt

  parking Parking @relation(fields: [parkingId], references: [id], onDelete: Cascade)

  @@unique([parkingId, kind])
  @@map("parking_extras")
}

// A service ordered by a traveller on a Plazo booking (app only), paid online: with the booking itself (`withBooking`,
// one payment for the stay and its services) or later in its own PaymentIntent. One active order per kind (partial
// unique index), one charge at most (service). Its money follows the booking's payout schedule once it is done.
model ReservationExtra {
  id                    String        @id @default(cuid())
  reservationId         String
  operatorId            String
  kind                  ExtraKind
  // Name and amounts frozen at the order (the parking may change its prices afterwards).
  label                 String
  priceCents            Int
  commissionCents       Int
  operatorShareCents    Int
  status                ExtraStatus   @default(pending_payment)
  withBooking           Boolean       @default(false)
  // Its own payment (null when paid with the booking: the booking's intent).
  stripePaymentIntentId String?       @unique
  stripeLive            Boolean?
  stripeChargeId        String?
  stripeRefundId        String?
  stripeTransferId      String?
  payoutStatus          PayoutStatus?
  paidAt                DateTime?
  doneAt                DateTime?
  doneById              String?
  refusedAt             DateTime?
  refusedById           String?
  refusedReason         String?
  refundedAt            DateTime?
  transferredAt         DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @default(now()) @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  doneBy      Staff?      @relation("ExtraDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  refusedBy   Staff?      @relation("ExtraRefusedBy", fields: [refusedById], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([operatorId, status])
  @@index([payoutStatus, status])
  @@map("reservation_extras")
}

/// 21/10/2026 (C): a prospect's own link to the demo (plazo.fr/pro/demo/<token>), valid 14 days; Plazo counts its opens.
model DemoLink {
  id           String    @id @default(cuid())
  token        String    @unique
  prospectId   String?   @unique
  createdById  String?
  expiresAt    DateTime
  opens        Int       @default(0)
  lastOpenedAt DateTime?
  createdAt    DateTime  @default(now())

  prospect Prospect? @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@map("demo_links")
}
