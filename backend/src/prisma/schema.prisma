generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  output          = "../generated/prisma-client"
  // Vercel functions run on Amazon Linux 2023.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// An operator is a parking company (a "loueur"). Everything is scoped by operator.
model Operator {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  staff        Staff[]
  parkings     Parking[]
  auditLogs    AuditLog[]
  reservations Reservation[]

  @@map("operators")
}

enum StaffRole {
  manager
  agent
  driver
  valet
}

// Operator personnel: manager, front-desk agent, shuttle driver, valet.
model Staff {
  id          String    @id @default(cuid())
  operatorId  String
  email       String    @unique // always lower-cased
  name        String
  phone       String?
  role        StaffRole
  password    String
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  operator            Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  tokens              StaffToken[]
  auditLogs           AuditLog[]
  createdReservations Reservation[]

  @@index([operatorId])
  @@map("staff")
}

enum StaffTokenType {
  access
  refresh
}

// Every issued JWT is stored so it can be revoked (logout, deactivation, password change).
model StaffToken {
  id        String         @id @default(cuid())
  uid       String         @unique @default(uuid())
  staffId   String
  type      StaffTokenType
  expiresAt DateTime
  metadata  Json?          @default("{}")
  createdAt DateTime       @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_tokens")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("login_attempts")
}

model Parking {
  id                   String                                @id @default(cuid())
  operatorId           String
  name                 String
  address              String?
  // Entrance point (WGS84). The detailed map arrives in milestone 4. Read/write through raw SQL.
  location             Unsupported("geometry(Point, 4326)")?
  timezone             String                                @default("Europe/Paris")
  totalCapacity        Int
  // Share of spots never offered for booking, in percent (0-50).
  safetyMarginPct      Int                                   @default(0)
  shuttleTravelMinutes Int                                   @default(8)
  createdAt            DateTime                              @default(now())
  updatedAt            DateTime                              @default(now()) @updatedAt

  operator     Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([operatorId])
  @@map("parkings")
}

model AuditLog {
  id         String   @id @default(cuid())
  operatorId String
  staffId    String?
  action     String
  entityType String
  entityId   String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  staff    Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([operatorId, createdAt])
  @@map("audit_logs")
}

enum ReservationStatus {
  upcoming // booked, vehicle not dropped yet
  arrived // vehicle dropped at the parking
  shuttled_out // customer driven to the terminal
  return_requested // customer back, waiting for pick-up
  returned // vehicle handed back
  cancelled
  no_show
}

enum ReservationChannel {
  website // the operator's own booking page (milestone 3)
  phone
  counter
  aggregator // Parkos, Onepark… (name in channelDetail)
  import
}

// A booking. Times are stored in UTC; "nights" are counted in the parking's timezone.
model Reservation {
  id                String             @id @default(cuid())
  reference         String             @unique // short code given to the customer
  operatorId        String
  parkingId         String
  channel           ReservationChannel
  channelDetail     String?
  status            ReservationStatus  @default(upcoming)
  arrivalAt         DateTime
  returnAt          DateTime
  passengers        Int
  customerName      String
  customerPhone     String
  customerEmail     String?
  plate             String // display form, e.g. AB-123-CD
  plateKey          String // letters and digits only, for search
  returnFlight      String? // e.g. TO 3627
  notes             String?
  // Booking number on the channel it came from (e.g. AL-884880719 on Allopark), to avoid importing it twice.
  externalReference String?
  // Price paid, in euro cents, when known (imports; the pricing grid arrives in milestone 3).
  priceCents        Int?
  // Saved although at least one night was already full (forced by staff, audited).
  overbooked        Boolean            @default(false)
  createdById       String?
  arrivedAt         DateTime?
  returnedAt        DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt

  operator  Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  parking   Parking  @relation(fields: [parkingId], references: [id], onDelete: Cascade)
  createdBy Staff?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([operatorId, externalReference])
  @@index([parkingId, arrivalAt])
  @@index([parkingId, returnAt])
  @@index([operatorId, plateKey])
  @@map("reservations")
}
