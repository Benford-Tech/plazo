NODE_ENV=development
PORT=3005
# Origins allowed to call the API from another origin (comma-separated). Not needed when the pro
# space and the site call /api on their own origin (Vercel, and `npm run dev` through its proxy).
CLIENT_URL=
# Long random strings (e.g. `openssl rand -hex 32`).
SECRET_KEY=change-me-staff-jwt-secret
# Supabase: transaction pooler (port 6543) with ?pgbouncer=true for the app.
DATABASE_URL=postgresql://plazo:plazo@localhost:5432/plazo
# Supabase: direct connection (port 5432) for migrations.
DIRECT_URL=postgresql://plazo:plazo@localhost:5432/plazo
# Shared with Vercel Cron, which sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me-cron-secret
# Dedicated database for the test suite (wiped on every run).
DATABASE_URL_TEST=postgresql://plazo:plazo@localhost:5432/plazo_test
# Platform administrators (comma-separated emails): only these staff members see the internal tools
# (capacity estimator, /api/internal/platform/...). Empty: nobody.
PLATFORM_ADMIN_EMAILS=
# Default Plazo commission in basis points (1500 = 15 %); each operator can override it.
PLATFORM_COMMISSION_BPS=

# --- Traveller site and notifications ---
# Shared secret the traveller site sends in x-plazo-site-key on its server-side calls (same value
# in the site's environment). When it matches, rate limits count the traveller's IP sent in
# x-plazo-client-ip instead of the site's own IP. REQUIRED in production (the API refuses to start
# without it); may stay empty in development, where every caller is counted by its own IP.
SITE_API_KEY=
# Anthropic API key: lets Claude propose the parking zones from the IGN photo (Parking › Plan › Zones).
# Empty: the button answers "indisponible". ZONE_SUGGESTION_MODEL pins the model (default claude-opus-5-5).
ANTHROPIC_API_KEY=
ZONE_SUGGESTION_MODEL=
# L-A (08/10/2026): the same key lets Claude read the forwarded emails no importer knows (booking created when complete
# and sure). EMAIL_READING_MODEL pins that model (default claude-opus-5-5). Empty key: those emails wait in "À vérifier".
EMAIL_READING_MODEL=
# 09/10/2026: the same key lets Claude write the « Présentation » of the Plazo page (Plazo › Fiche, « Rédiger avec Claude »,
# nothing saved). LISTING_DESCRIPTION_MODEL pins that model (default claude-opus-5-5). Empty key: the button answers "indisponible".
LISTING_DESCRIPTION_MODEL=
# Brevo API key (transactional emails and SMS). Empty: nothing is sent, one log line per booking.
BREVO_API_KEY=
# Email sender, verified in Brevo: "Name <address>" or a bare address (name: the product name).
EMAIL_FROM=
# Inbound emails (M-A): domain of the operators' addresses (<slug>@<domain>, e.g. plazo.fr: the apex domain, Cloudflare's catch-all needs it) and the secret shared
# with the Cloudflare relay (email-worker/, header X-Inbound-Secret). Both empty: the "Mails entrants" block says so.
INBOUND_EMAIL_DOMAIN=
INBOUND_EMAIL_SECRET=
# SMS sender: 11 letters or digits at most (default: the product name).
SMS_SENDER=
# Confirmation SMS per rolling 24 hours at most (default 300); above it only the email is sent.
SMS_DAILY_LIMIT=
# Operators may send their SMS from their own Android phone (app "SMS Gateway for Android", free).
# The app's password is encrypted at rest with this key: 32 bytes in base64, `openssl rand -base64 32`.
# Required as soon as an operator links a phone (Vercel env only; changing it unlinks every phone).
SMS_GATEWAY_ENCRYPTION_KEY=
# Public base URL of the traveller site, for the "manage my booking" links in emails and SMS
# (e.g. https://www.example.com). On Vercel it defaults to the project's production domain.
PUBLIC_SITE_URL=

# --- Online payment (Stripe Connect, TEST mode until the legal validation) ---
# Empty: online payment is off and travellers pay at the parking (the flow stays as before).
# A live key (sk_live_/rk_live_) is refused in production unless STRIPE_ALLOW_LIVE=true.
# With payments on, an operator is bookable online once its Stripe account can take charges and
# it has a commission (its own or PLATFORM_COMMISSION_BPS). PUBLIC_SITE_URL is required (return URLs).
STRIPE_SECRET_KEY=
# Optional: publishable key (pk_test_…) of the same account, for the mobile app's native payment sheet
# (GET /api/public/payments/config). Empty: the app falls back to the Checkout page.
STRIPE_PUBLISHABLE_KEY=
# Signing secret(s) of the webhook endpoint(s) /api/public/stripe/webhook (whsec_…), comma-separated:
# one for the platform's events, one for the connected accounts' events (account.updated).
# Platform events to send: checkout.session.completed / async_payment_succeeded / async_payment_failed /
# expired, payment_intent.succeeded, payment_intent.payment_failed; connected accounts: account.updated.
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Development / end-to-end tests only: a fake Stripe API (e.g. http://localhost:12111). Ignored in production.
STRIPE_API_BASE=

# --- Push notifications to the staff app (OneSignal) ---
# Both empty: no push is sent (arrivals still show in the pro space and the app's polling).
# OneSignal dashboard → Settings → Keys & IDs. The REST API key is a secret: Vercel env only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Traveller app (its own OneSignal app); left empty, the staff app's values are used.
ONESIGNAL_TRAVELLER_APP_ID=
ONESIGNAL_TRAVELLER_REST_API_KEY=

# --- Flight tracking (optional) ---
# FlightAware AeroAPI v4, "Personal" plan: 5 $ of queries offered every month (card on file, nothing
# charged below that). flightaware.com/aeroapi → create an API key → FLIGHTAWARE_API_KEY.
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_BASE_URL=
# AeroDataBox through RapidAPI (free "Basic" plan): rapidapi.com → "AeroDataBox" → Subscribe → the
# key shown as X-RapidAPI-Key. Bought on API.Market instead? Set AERODATABOX_BASE_URL to
# https://prod.api.market/api/v1/aedbx/aerodatabox (the key is then sent as x-magicapi-key).
AERODATABOX_API_KEY=
AERODATABOX_BASE_URL=
# AirLabs (registration currently closed: optional, kept as a fallback provider).
AIRLABS_API_KEY=
# flightaware | aerodatabox | airlabs. Empty: the provider whose key is set (in that order).
FLIGHT_TRACKING_PROVIDER=
