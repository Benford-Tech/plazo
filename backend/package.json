{
  "name": "plazo-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --trace-warnings",
    "test": "jest --runInBand --forceExit --detectOpenHandles",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && rm -rf lib && tsc -p tsconfig.build.json && npm run copy:assets && tsc-alias -p tsconfig.build.json",
    "copy:assets": "cp -r src/generated lib/generated && cp ../product.json lib/product.json",
    "vercel-build": "export DIRECT_URL=${DIRECT_URL:-$DATABASE_URL_UNPOOLED}; prisma migrate deploy && npm run build && node lib/scripts/bootstrap-platform-admin.js && node lib/scripts/seed-demo.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:operator": "ts-node -r tsconfig-paths/register --transpile-only src/scripts/create-operator.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register --transpile-only src/scripts/seed-demo.ts",
    "start": "node lib/server.js"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.5",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-status": "^2.1.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.3",
    "jsts": "^2.12.1",
    "morgan": "^1.12.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "proj4": "^2.22.0",
    "reflect-metadata": "^0.2.2",
    "stripe": "23.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typedi": "^0.10.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/proj4": "^2.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.7",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
