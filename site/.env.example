# Base URL of the API (the backend service). On Vercel it is injected at runtime by the service
# binding declared in the repository's vercel.json: do not set it there. Locally: the backend's dev server.
BACKEND_URL=http://localhost:3005

# Shared secret sent to the API in the x-plazo-site-key header, so that the API rate-limits each
# traveller by their own IP instead of the site's. Same value as SITE_API_KEY on the backend.
# May stay empty locally.
SITE_API_KEY=

# Public address of the site (canonical URLs, sitemap, Open Graph). On Vercel, defaults to the
# project's production domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
