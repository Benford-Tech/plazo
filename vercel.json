{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cdg1"],
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "index.js",
      "buildCommand": "npm run vercel-build",
      "functions": {
        "index.js": {
          "includeFiles": "{backend/lib/product.json,backend/lib/routes/*.js,backend/node_modules/swagger-ui-dist/**}"
        }
      },
      "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }]
    },
    "admin": {
      "root": "admin",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/pro/:path*", "destination": "/pro/index.html" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
          ]
        }
      ]
    },
    "site": {
      "root": "site",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/pro/:path*", "destination": { "service": "admin" } },
    { "source": "/(.*)", "destination": { "service": "site" } }
  ],
  "crons": [
    { "path": "/api/internal/cron/purge-expired-tokens", "schedule": "0 1 * * *" },
    { "path": "/api/internal/cron/payouts", "schedule": "0 6 * * *" },
    { "path": "/api/internal/cron/track-return-flights", "schedule": "0 3 * * *" }
  ]
}
