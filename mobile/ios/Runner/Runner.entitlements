<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Staff push notifications (OneSignal). Codemagic signs with an App Store profile: production. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal links of the booking pages: the production site serves
	     /.well-known/apple-app-site-association (site/public/.well-known/). The App ID needs the
	     Associated Domains capability. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.plazo.fr</string>
	</array>
</dict>
</plist>
