<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!-- Plazo Pro launch screen, direction A « Citron » (02/11/2026): the login screen's wordmark centred on lime #A3E635,
     « by Benford Tech » above the home indicator. Chosen by LAUNCH_SCREEN_NAME in the -pro configurations.
     Images (LaunchPro, LaunchProBy) by brand/app/tools/splash_pro.mjs. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="12121" systemVersion="16G29" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="Pro-lp-oVM">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <scenes>
        <scene sceneID="Pro-sc-A2E">
            <objects>
                <viewController id="Pro-lp-oVM" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="Pro-tg-yQy"/>
                        <viewControllerLayoutGuide type="bottom" id="Pro-bg-2k8"/>
                    </layoutGuides>
                    <view key="view" contentMode="scaleToFill" id="Pro-vw-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" image="LaunchPro" translatesAutoresizingMaskIntoConstraints="NO" id="Pro-wm-Ey4">
                            </imageView>
                            <imageView opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" image="LaunchProBy" translatesAutoresizingMaskIntoConstraints="NO" id="Pro-by-Ey5">
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.63921568627450975" green="0.90196078431372551" blue="0.20784313725490197" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="Pro-wm-Ey4" firstAttribute="centerX" secondItem="Pro-vw-2t3" secondAttribute="centerX" id="Pro-c1-vTC"/>
                            <constraint firstItem="Pro-wm-Ey4" firstAttribute="centerY" secondItem="Pro-vw-2t3" secondAttribute="centerY" id="Pro-c2-R7a"/>
                            <constraint firstItem="Pro-by-Ey5" firstAttribute="centerX" secondItem="Pro-vw-2t3" secondAttribute="centerX" id="Pro-c3-vTD"/>
                            <constraint firstItem="Pro-bg-2k8" firstAttribute="top" secondItem="Pro-by-Ey5" secondAttribute="bottom" constant="24" id="Pro-c4-R7b"/>
                        </constraints>
                    </view>
